# Variables d'environnement NIKAHYA
# Local development: copy this file to .env.local.
# Never commit real credentials or secrets.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL — server-side only; never prefix with NEXT_PUBLIC_.
# Use the pooled connection string from Neon and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Password recovery via Resend (server-side only). Verify a sender domain for unrestricted delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NIKAHYA <onboarding@resend.dev>

# OAuth social (server-side secrets; never prefix these values with NEXT_PUBLIC_).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# Optional: Stripe billing (leave empty until Stripe is integrated).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
