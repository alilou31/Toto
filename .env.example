# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL connection string (server-only; do not use NEXT_PUBLIC_).
# Copy the pooled connection string from Neon and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Legacy Supabase variables are retained only while the project is migrating.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
