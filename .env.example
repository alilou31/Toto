# Variables d'environnement NIKAHYA
# Local development: copy this file to .env.local.
# Never commit real credentials or secrets.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL — server-side only; never prefix with NEXT_PUBLIC_.
# Use the pooled connection string from Neon and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Transactional messages (password reset, newsletter and account confirmation).
# Verify nakahya.com in Resend and configure DNS SPF/DKIM/DMARC first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NAKAHYA <notifications@nakahya.com>
# Turn on ONLY after migration 017 has been applied in Neon and a test sender is verified.
EMAIL_VERIFICATION_ENABLED=false

# OAuth social (server-side secrets; never prefix these values with NEXT_PUBLIC_).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0

# Stripe Identity: automatic document + selfie verification. Configure in Cloudflare as secrets.
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Optional Stripe billing webhooks (separate from Identity).
STRIPE_WEBHOOK_SECRET=

# Optional aggregate affiliate click metrics — server-side, disabled by default.
# Apply migration 016 and review retention/operations before manual activation.
BON_PLANS_METRICS_ENABLED=false
# Optional allowlist for the Voice of Customer dashboard; comma-separated account e-mails.
# The dashboard remains closed when this value is empty.
FEEDBACK_ADMIN_EMAILS=
