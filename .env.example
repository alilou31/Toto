# Variables d'environnement NIKAHYA
# Local development: copy this file to .env.local.
# Never commit real credentials or secrets.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL — server-side only; never prefix with NEXT_PUBLIC_.
# Use the pooled connection string from Neon and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: Stripe billing (leave empty until Stripe is integrated).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
