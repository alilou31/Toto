{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nikahya",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nakahya.com",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://nakahya.com",
    "RESEND_FROM_EMAIL": "NAKAHYA <notifications@nakahya.com>"
  },
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nikahya"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "CHAT_MEDIA_BUCKET",
      "bucket_name": "nakahya-chat-media"
    }
  ]
}
