{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nikahya",
  "workers_dev": true,
  "keep_vars": true,
  "vars": { "NEXT_PUBLIC_SITE_URL": "https://nakahya.com", "RESEND_FROM_EMAIL": "NAKAHYA <notifications@nakahya.com>" },
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nikahya"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}

